{
  "name": "cypress-project-example",
  "version": "1.0.0",
  "description": "Cypress Test Project with JUnit Reports",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "cypress run --reporter junit --reporter-options 'mochaFile=cypress/reports/junit-[hash].xml,toConsole=true'",
    "test:headed": "cypress run --headed",
    "report:merge": "echo 'JUnit reports are generated individually per spec file. Use a tool to merge if needed or configure Azure DevOps to pick up multiple files.'",
    "clean:reports": "rm -rf cypress/reports/*"
  },
  "keywords": [
    "cypress",
    "testing",
    "e2e",
    "api",
    "junit"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.10.0",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1"
  }
}
